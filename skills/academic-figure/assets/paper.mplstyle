# Mechanics that are not design tokens; every size and color comes from DESIGN.md through paper.use_design().
font.family: sans-serif
mathtext.fontset: custom
# symbols Inter lacks (sqrt, sum, relations, \mathbb) use STIX Sans, which ships with matplotlib
mathtext.fallback: stixsans
mathtext.cal: STIXNonUnicode:italic
# no Inter Bold Italic is bundled; without this matplotlib warns on every math label
mathtext.bfit: sans:bold

# a full box, with ticks sticking out of it
axes.spines.top: True
axes.spines.right: True
axes.grid: True
axes.grid.axis: both
axes.axisbelow: True

# hollow markers: white fill, an edge in the line's color
lines.markerfacecolor: FFFFFF
lines.markeredgecolor: auto

# box plots: black outline, whiskers, caps and median; the box is filled with its series color
boxplot.patchartist: True
boxplot.boxprops.color: black
boxplot.whiskerprops.color: black
boxplot.capprops.color: black
boxplot.medianprops.color: black
boxplot.flierprops.marker: o
boxplot.flierprops.markeredgecolor: black
boxplot.flierprops.markerfacecolor: FFFFFF

legend.handlelength: 1.5
legend.handletextpad: 0.5
legend.columnspacing: 1.0
legend.labelspacing: 0.25
legend.fancybox: False
legend.edgecolor: DDDDDD
legend.facecolor: FFFFFF
legend.framealpha: 1
legend.borderpad: 0.3
legend.borderaxespad: 0.5

figure.constrained_layout.use: True
figure.constrained_layout.hspace: 0
figure.constrained_layout.wspace: 0

savefig.dpi: 300
# embedded TrueType (never Type 3, which venues reject); PDF text stays selectable text
pdf.fonttype: 42
